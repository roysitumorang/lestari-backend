ENV=development
APP_ADDR=:8080
API_PREFIX=/api/v1

# PostgreSQL 18. DB_READ_URL may point at a replica; leave it empty to read from DB_WRITE_URL.
DB_WRITE_URL=postgres://postgres:postgres@localhost:5432/lestari?sslmode=disable
DB_READ_URL=
DB_MAX_CONNECTIONS=10

TZ=Asia/Jakarta
APP_TIMEZONE=Asia/Jakarta

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h

CORS_ORIGINS=http://localhost:5500
PUBLIC_URL=http://localhost:8080
UPLOAD_DIR=./storage/uploads
BODY_LIMIT_MB=20

# Reverse proxies allowed to report the client IP (nginx on this machine = loopback; none = disable)
TRUSTED_PROXIES=loopback
PROXY_HEADER=X-Forwarded-For

SENTRY_ENABLED=0
SENTRY_DSN=

# error = only errors; anything else = info
LOG_LEVEL=info
