        }
    },
    "definitions": {
        "controllers.BulkDeleteRequest": {
            "type": "object",
            "properties": {
                "ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "019a5f3c-8b2e-7d41-9c3a-5e8f1b2c4d6a",
                        "019a5f3c-8b2e-7d41-9c3a-5e8f1b2c4d6b"
                    ]
                }
            }
        },
        "controllers.DeletedResponse": {
            "type": "object",
            "properties": {
                "deleted": {
                    "type": "integer",
                    "example": 3
                }
            }
        },
        "helper.ErrorData": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "validation_failed"
                },
                "fields": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "helper.Pagination": {
            "type": "object",
            "properties": {
                "chart": {},
                "info": {
                    "type": "object",
                    "properties": {
                        "limit": {
                            "type": "integer",
                            "example": 25
                        },
                        "page": {
                            "type": "integer",
                            "example": 1
                        },
                        "pages": {
                            "type": "integer",
                            "example": 5
                        },
                        "total": {
                            "type": "integer",
                            "example": 120
                        }
                    }
                },
                "links": {
                    "type": "object",
                    "properties": {
                        "current": {
                            "type": "string",
                            "example": "http://localhost:8080/api/v1/taxes?page=1\u0026per_page=25"
                        },
                        "first": {
                            "type": "string",
                            "example": "http://localhost:8080/api/v1/taxes?per_page=25"
                        },
                        "last": {
                            "type": "string",
                            "example": "http://localhost:8080/api/v1/taxes?page=5\u0026per_page=25"
                        },
                        "next": {
                            "type": "string",
                            "example": "http://localhost:8080/api/v1/taxes?page=2\u0026per_page=25"
                        },
                        "previous": {
                            "type": "string",
                            "example": ""
                        }
                    }
                },
                "rows": {},
                "summary": {
                    "description": "reports only"
                },
                "totals": {}
            }
        },
        "helper.Response": {
            "type": "object",
            "properties": {
                "app": {
                    "type": "string",
                    "example": "lestari"
                },
                "data": {},
                "latency": {
                    "type": "string",
                    "example": "7.746177ms"
                },
                "message": {
                    "type": "string",
                    "example": ""
                },
                "request_id": {
                    "type": "string",
                    "example": "6ba3451b-ac73-483e-8481-2ac53f5e75a2"
                },
                "request_url": {
                    "type": "string",
                    "example": "GET http://localhost:8080/api/v1/taxes"
                },
                "status": {
                    "type": "string",
                    "example": "OK"
                },
                "status_code": {
                    "type": "integer",
                    "example": 200
                },
                "timestamp": {
                    "type": "string",
                    "example": "2026-11-11T14:22:47.608963985+07:00"
                }
            }
        },
        "models.Tax": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string",
                    "example": "2026-11-08T10:32:00+07:00"
                },
                "id": {
                    "type": "string",
                    "example": "019a5f3c-8b2e-7d41-9c3a-5e8f1b2c4d6a"
                },
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "is_inclusive": {
                    "type": "boolean",
                    "example": false
                },
                "name": {
                    "type": "string",
                    "example": "PPN"
                },
                "rate": {
                    "type": "number",
                    "example": 11
                },
                "updated_at": {
                    "type": "string",
                    "example": "2026-11-08T10:32:00+07:00"
                }
            }
        },
        "models.TaxRequest": {
            "type": "object",
            "properties": {
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "is_inclusive": {
                    "type": "boolean",
                    "example": false
                },
                "name": {
                    "type": "string",
                    "example": "PPN"
                },
                "rate": {
                    "type": "number",
                    "maximum": 100,
                    "minimum": 0,
                    "example": 11
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "\"Bearer \u003caccess_token\u003e\" from POST /auth/login",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    },
    "security": [
        {
            "BearerAuth": []
        }
    ]
}