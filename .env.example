APP_ENV=development
APP_ADDR=:8080
API_PREFIX=/api/v1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lestari?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h
